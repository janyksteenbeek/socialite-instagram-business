package.json
{
  "name": "socialite-instagram-business-laravel-13-test",
  "version": "1.0.0",
  "description": "Laravel 13 compatibility test for socialite-instagram-business package",
  "main": "artisan",
  "scripts": {
    "dev": "php artisan serve",
    "test": "phpunit"
  },
  "keywords": [
    "laravel",
    "oauth",
    "instagram",
    "business",
    "socialite",
    "testing"
  ],
  "author": "Test Author",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "socialiteproviders/manager": "^4.9",
    "janyksteenbeek/socialite-instagram-business": "*"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9.1",
    "laravel/pint": "^1.17",
    "laravel/sail": "^1.38",
    "mockery/mockery": "^1.0",
    "nunomaduro/collision": "^7.7",
    "phpunit/phpunit": "^9.5",
    "spatie/laravel-ignition": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "JanykSteenbeek\\SocialiteInstagramBusiness\\Tests\\": "tests/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "path": "./.."
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}